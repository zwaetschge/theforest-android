+class _HintlessInsn:
+    """A capstone instruction whose `bnd ` / `notrack ` prefix is dropped from the mnemonic.
+
+    MSVC's CET/MPX-compatible helpers (__chkstk: `bnd jae`, `bnd ret`) carry these hint prefixes;
+    they change nothing about what the instruction does, but every check of the mnemonic
+    (branch labels, the jcc/ret translation) would otherwise miss the branch."""
+    __slots__ = ('_i', 'mnemonic')
+
+    def __init__(self, i, m):
+        self._i = i
+        self.mnemonic = m
+
+    def __getattr__(self, a):
+        return getattr(self._i, a)
+
+
+def _strip_hint_prefixes(insns):
+    out = []
+    for i in insns:
+        m = i.mnemonic
+        if m.startswith('bnd ') or m.startswith('notrack '):
+            out.append(_HintlessInsn(i, m.split(' ', 1)[1]))
+        else:
+            out.append(i)
+    return out
+
