+static gchar *w64_translate_if_win (const gchar *filename)
+{
+	if (!filename || !w64_mono_translate_path) return NULL;
+	const char *win = NULL;
+	if ((g_ascii_isalpha ((guchar)filename [0]) && filename [1] == ':') || strchr (filename, '\\') != NULL) {
+		win = filename;
+	} else {
+		const char *p = filename;
+		while ((p = strchr (p, ':')) != NULL) {
+			if (p >= filename + 2 && p [-2] == '/' && g_ascii_isalpha ((guchar)p [-1]) && (p [1] == '/' || p [1] == '\\' || p [1] == '\0')) {
+				win = p - 1;
+				break;
+			}
+			p++;
+		}
+	}
+	if (!win) return NULL;
+	char buf [1024];
+	w64_mono_translate_path (win, buf, sizeof (buf));
+	return buf [0] ? g_strdup (buf) : NULL;
+}
